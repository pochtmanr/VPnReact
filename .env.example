# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# VPN Backend API
EXPO_PUBLIC_VPN_API_URL=https://www.dopplervpn.org

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-key-here
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-key-here

# AdGuard Home (internal VPN network)
EXPO_PUBLIC_ADGUARD_URL=http://10.0.0.1:3000
EXPO_PUBLIC_ADGUARD_USERNAME=admin
EXPO_PUBLIC_ADGUARD_PASSWORD=your-password-here

# Promo API
EXPO_PUBLIC_PROMO_API_URL=https://your-miniapp.vercel.app

# For database population script (use service_role key, NOT anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
