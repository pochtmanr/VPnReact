{
  "expo": {
    "name": "Doppler VPN",
    "slug": "doppler-vpn",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vpnshield",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/NoBgLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simnetiq.vpnreact",
      "infoPlist": {
        "NSVPNNetworkExtensionUsageDescription": "This app uses VPN to protect your privacy and secure your internet connection.",
        "NSLocalNetworkUsageDescription": "This app requires access to network features for VPN functionality",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      },
      "entitlements": {
        "com.apple.developer.networking.networkextension": [
          "packet-tunnel-provider"
        ],
        "com.apple.developer.networking.vpn.api": [
          "allow-vpn"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/NoBgLogo.png",
        "backgroundColor": "#0A0A0F",
        "monochromeImage": "./assets/images/WhiteLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.simnetiq.vpnreact"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withAndroidVPN",
      "./plugins/withVPNExtension"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
